#--1 FUNCTIONS
#--1 OTHERS
    #--2 SSH_AUTH_SOCK
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/keyring/ssh"

    #--2 VNC
    export TVNC_XKBIGNORELOCK=1
    alias startvnc='/opt/TurboVNC/bin/vncserver -depth 16 -fg -geometry 5140x1440 -xstartup ~/.Xsession :12 &'
    alias stopvnc='/opt/TurboVNC/bin/vncserver -kill :12'
    if [ "$LAUNCH_VNC" = "1" ]; then
        unset LAUNCH_VNC
        if ! pgrep -f "Xvnc.*:12" > /dev/null; then
            startvnc
        fi
    fi

#++#++#++#++#++#++#++# END OF GENERAL CONFIG #++#++#++#++#++#++#++#

