############################### COMMON CONFIG BASHRC ###############################

#####################    ENVIRONEMENT    #####################
#--1
export MY_ENV="WORK" # Set environement. Valid values: HOME, WORK.
#++#++#++#++#++#++#++# ENVIRONEMENT END #++#++#++#++#++#++#++#

########################    CONFIG    ########################
#--1 XDG SESSION TYPE
export XDG_SESSION_TYPE=x11

#--1 WIKI PATHS
WIKI_PATH=~/Desktop/Media/Documents/Wiki/
WIKI_NAS_PATH=~/Desktop/Remote/NAS/Wiki/

#--1 SCRIPT PATH
export MY_SCRIPTS_PATH="$HOME/.local/scripts"

#--1 PROGRAMS PATH
export MY_PROGRAMS_PATH="$HOME/Others/Programs"

#++#++#++#++#++#++#++#++# CONFIG END #++#++#++#++#++#++#++#++#

####################    SOURCE BASHRC    #####################
#--1 
source ~/.bashrc.common
source ~/.bashrc.custom
#++#++#++#++#++#++#++# SOURCE BASHRC END #++#++#++#++#++#++#++#

# vim: foldmethod=marker foldmarker=#--,#++ filetype=bash
