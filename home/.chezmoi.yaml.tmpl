# Generated by chezmoi from .chezmoi.yaml.tmpl
{{- $machine := promptStringOnce . "machine" "Machine type (home_notebook/work_vm/work_wsl/work_mac/work_mac_vm)" }}

{{- $decrypt_secrets := promptBoolOnce . "decrypt_secrets" "Decrypt secrets?" false -}}
{{- $passphrase := "" -}}
{{- if not $decrypt_secrets }}
apply:
  exclude:
    - encrypted
{{- else }}
{{-   $passphrase = promptStringOnce . "passphrase" "Enter encryption passphrase" }}
encryption: gpg
gpg:
  symmetric: true
  args:
    - --batch
    - --passphrase
    - {{ $passphrase | quote }}
    - --no-symkey-cache
{{- end }}

diff:
  exclude:
    - scripts

hooks:
  diff:
    pre:
      script: "{{- joinPath .chezmoi.sourceDir ".hooks/diff/pre/hooks.sh" -}}"

data:
  machine: {{ $machine | quote }}
  passphrase: {{ $passphrase | quote }}
  features:
{{- $pkgFile := joinPath .chezmoi.workingTree "machines" $machine "features.yaml" -}}
{{- if stat $pkgFile }}
{{ include $pkgFile | indent 4 }}
{{- else }}
    {} # Fallback if packages.yaml is missing
{{- end }}
