#!/usr/bin/env bash

# Trigger change tracking on directory changes or internal file edits of general scripts
{{- $scriptPattern := printf "scripts/*" -}}
{{- range glob (joinPath .chezmoi.sourceDir $scriptPattern) }}
# - {{ . }}: {{ include . | sha256sum }}
{{- end }}

# Leverage Chezmoi's knowledge of its own binary location, with a hardcoded fallback
CHEZMOI_BIN="{{ .chezmoi.executable }}"
[ -x "$CHEZMOI_BIN" ] || CHEZMOI_BIN="$HOME/.local/bin/chezmoi"

SCRIPT_LIST="$HOME/.config/chezmoi/packages_script.txt"
SCRIPT_DIR={{- joinPath .chezmoi.workingTree "scripts" }}

if [ -s "$SCRIPT_LIST" ]; then
    echo "Executing custom script hooks from $SCRIPT_LIST..."

    # Simple, standard line-by-line read
    while read -r script; do
        SCRIPT_PATH="$SCRIPT_DIR/$script"

        if [ -f "$SCRIPT_PATH" ] || [ -f "${SCRIPT_PATH}.tmpl" ]; then
            echo "🚀 Running script hook: $script"

            EXEC_PATH="$SCRIPT_PATH"
            IS_TMP=false

            if [ -f "${SCRIPT_PATH}.tmpl" ]; then
                SCRIPT_PATH="${SCRIPT_PATH}.tmpl"
            fi

            # If the script is a template, compile it before execution
            if [[ "$SCRIPT_PATH" == *.tmpl ]]; then
                TEMP_SCRIPT=$(mktemp "$SCRIPT_DIR/tmp.XXXXXX")
                
                if "$CHEZMOI_BIN" execute-template < "$SCRIPT_PATH" > "$TEMP_SCRIPT"; then
                    EXEC_PATH="$TEMP_SCRIPT"
                    IS_TMP=true
                else
                    echo "❌ Error: Failed to render template for $script"
                    rm -f "$TEMP_SCRIPT"
                    continue
                fi
            fi

            chmod +x "$EXEC_PATH"

            # Execute in a subshell so an 'exit 1' inside a script won't crash Chezmoi
            ( "$EXEC_PATH" )
            SCRIPT_RC=$?

            # Clean up the rendered copy if a temporary file was generated
            if [ "$IS_TMP" = true ]; then
                rm -f "$EXEC_PATH"
            fi

            if [ $SCRIPT_RC -ne 0 ]; then
                echo "⚠️ Warning: Script $script exited with an error code."
            fi
        else
            echo "❌ Error: Script executable not found at $SCRIPT_PATH"
        fi
    done < "$SCRIPT_LIST"

    echo "All script hooks processed."
else
    echo "No script hooks listed in $SCRIPT_LIST. Skipping."
fi


