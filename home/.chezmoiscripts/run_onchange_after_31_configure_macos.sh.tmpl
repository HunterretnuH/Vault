{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# Trigger execution if the tracked settings files change:
# symbolichotkeys hash: {{ include "dot_config/macos_preferences/symbolichotkeys.plist" | sha256sum }}
# app_shortcuts hash: {{ include "dot_config/macos_preferences/app_shortcuts.txt" | sha256sum }}

echo "🚀 Applying macOS System Settings via Chezmoi..."

SETTINGS_DIR="$HOME/.config/macos_preferences"

# ==========================================
# 1. MAC OS SETTINGS
# ==========================================

# Trackpad: Enable Tap to Click (User & Login Screen)
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

# Trackpad: Disable “natural” (Lion-style) scrolling
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false

# Trackpad: Enable double tap and hold to drag (without lock)
# --- Internal MacBook Trackpad ---
defaults write com.apple.AppleMultitouchTrackpad Dragging -bool true
defaults write com.apple.AppleMultitouchTrackpad DragLock -bool false
# Ensure 3-finger drag is disabled so they don't fight
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool false

# --- External Magic Trackpad ---
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Dragging -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad DragLock -bool false
# Ensure 3-finger drag is disabled
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool false

# Dock: Autohide and Instant Autoshow
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0

# Dock: Don’t show recent applications in Dock
defaults write com.apple.dock show-recents -bool false

# Theme: Set dark mode.
 osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to true'

# ==========================================
# 2. DECLARATIVE IMPORTS (Keybindings)
# ==========================================

# Import System Keyboard Shortcuts
if [ -f "$SETTINGS_DIR/symbolichotkeys.plist" ]; then
    echo " -> Importing system hotkeys..."
    defaults import com.apple.symbolichotkeys "$SETTINGS_DIR/symbolichotkeys.plist"
fi

# Import Global Application Shortcuts
if [ -f "$SETTINGS_DIR/app_shortcuts.txt" ]; then
    echo " -> Importing application shortcuts..."
    APP_SHORTCUTS=$(cat "$SETTINGS_DIR/app_shortcuts.txt")
    defaults write -g NSUserKeyEquivalents "$APP_SHORTCUTS"
fi

# ==========================================
# 3. REFRESH DAEMONS & SERVICES
# ==========================================
echo " -> Flushing caches and restarting services..."
killall Dock 2>/dev/null
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u

echo "✅ macOS Settings Applied Successfully!"
{{ end }}



